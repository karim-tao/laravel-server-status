{
    "name": "karim-tao/laravel-server-status",
    "description": "A Livewire card that shows the current state of the server running your Laravel app: CPU, load, memory, disk, uptime and PHP-FPM processes. No daemon, no history, no database.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "server",
        "monitoring",
        "status"
    ],
    "homepage": "https://github.com/karim-tao/laravel-server-status",
    "license": "MIT",
    "authors": [
        {
            "name": "Karim Tao"
        }
    ],
    "support": {
        "issues": "https://github.com/karim-tao/laravel-server-status/issues",
        "source": "https://github.com/karim-tao/laravel-server-status"
    },
    "require": {
        "php": "^8.3",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "livewire/livewire": "^3.0 || ^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "KarimTao\\ServerStatus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KarimTao\\ServerStatus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KarimTao\\ServerStatus\\ServerStatusServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:static": "phpstan analyse",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:static",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
